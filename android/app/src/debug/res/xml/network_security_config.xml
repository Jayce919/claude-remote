<?xml version="1.0" encoding="utf-8"?>
<!--
  仅用于 debug 构建。
  局域网直连时服务地址是 http://192.168.x.x:8787 这种明文地址，如果只在白名单里放
  几个固定 host，用户填自己电脑的 IP 就会被系统拦掉——这是「装好包连不上」最常见的原因。
  debug 包本来就只用于自建服务的侧载，这里整体放开明文；正式签名包仍由主 manifest
  的 usesCleartextTraffic=false 强制 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
